{
    "expo": {
      "name": "Gloo",
      "slug": "gloo",
      "version": "1.0.0",
      "orientation": "portrait",
      "icon": "./assets/gloo.png",
      "scheme": "gloo",
      "userInterfaceStyle": "light",
      "splash": {
        "image": "./assets/background.jpeg",
        "resizeMode": "contain",
        "backgroundColor": "#ffffff"
      },
      "assetBundlePatterns": ["**/*"],
      "ios": {
        "supportsTablet": true,
        "bundleIdentifier": "com.gloo.app"
      },
      "android": {
        "package": "com.gloo.app",
        "adaptiveIcon": {
          "foregroundImage": "./assets/gloo.png",
          "backgroundColor": "#ffffff"
        }
      },
      "web": {
        "favicon": "./assets/gloo.png"
      },
      "extra": {
        "eas": {
          "projectId": "your-eas-project-id"
        }
      },
      "plugins": ["expo-router"]
    }
  }
  